# Server Configuration
PORT=8000
DATABASE_URL=postgres://<user>:<pass>@localhost:<port>/<taskdesk>

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Authentication
AUTH_COOKIE_NAME=taskdesk.auth

# Bootstrap Users (Optional - defaults shown)
ADMIN_SEED_EMAIL=admin@taskdesk.local
ADMIN_SEED_PASSWORD=ChangeMe123!
SUPPORT_SEED_EMAIL=support@taskdesk.local
SUPPORT_SEED_PASSWORD=ChangeMe123!

# Rate Limiting (Optional)
# Time window for rate limiting in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP within the window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Session Cleanup (Optional)
# Interval for cleaning up expired sessions in milliseconds (default: 1 hour)
SESSION_CLEANUP_INTERVAL_MS=3600000
